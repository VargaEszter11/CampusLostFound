# Example env overrides for the Spring Boot backend (copy values into your shell / IDE run config).
# Do not commit real secrets. For Neon, paste the connection details from the Neon dashboard.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campus_lost_found
SPRING_DATASOURCE_USERNAME=campus
SPRING_DATASOURCE_PASSWORD=campus

# Same Web OAuth client ID as VITE_GOOGLE_CLIENT_ID (Google Cloud Console)
GOOGLE_CLIENT_ID=
