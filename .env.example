# Copy to .env in the repo root (gitignored). Both apps read this one file:
#   backend  -> application.yml imports ../.env (run from backend/)
#   frontend -> vite.config.ts envDir: '..' (only VITE_* vars reach the browser)

# Google Sign-In — same Web OAuth client ID for both (Google Cloud Console)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Database (local Postgres or Neon)
# Only used without Docker; docker compose points the backend at its own `db` service.
# 5434 = the compose db's host port, so `npm run dev` + a local backend can use it too.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/campus_lost_found
SPRING_DATASOURCE_USERNAME=campus
SPRING_DATASOURCE_PASSWORD=campus

# Frontend dev proxy targets 8080 (frontend/vite.config.ts)
SERVER_PORT=8080

# Docker (docker compose) host ports — optional, defaults shown
# FRONTEND_HOST_PORT=5173
# BACKEND_HOST_PORT=8080
# DB_HOST_PORT=5434

# Comma-separated e-mails of admin users (can open the Admin page, see every report)
ADMIN_EMAILS=
